{
  "name": "milestr",
  "version": "1.2.1",
  "description": "Hierarchical goal, milestone, and KPI tracking CLI with auto-generated dashboard and Cloudflare Pages publishing",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "milestr": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-skill-version": "bash scripts/check-skill-version.sh",
    "check-migrations": "node scripts/check-migrations.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dr-Agentic/milestr.git"
  },
  "homepage": "https://github.com/Dr-Agentic/milestr#readme",
  "bugs": {
    "url": "https://github.com/Dr-Agentic/milestr/issues"
  },
  "keywords": [
    "milestones",
    "goals",
    "kpi",
    "dashboard",
    "cli",
    "tracking",
    "cloudflare-pages"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "wrangler": "^4.84.1"
  }
}
